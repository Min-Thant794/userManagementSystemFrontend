{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
        "source": "/api/:path*",
        "destination": "https://usermanagementsystem-api.onrender.com/api/:path*"
        },
        {
        "source": "/oauth2/authorization/:path*",
        "destination": "https://usermanagementsystem-api.onrender.com/oauth2/authorization/:path*"
        },
        {
        "source": "/login/oauth2/:path*",
        "destination": "https://usermanagementsystem-api.onrender.com/login/oauth2/:path*"
        },
        {
        "source": "/(.*)",
        "destination": "/index.html"
        }
    ]
}